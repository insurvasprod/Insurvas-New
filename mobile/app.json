{
  "expo": {
    "name": "Insurvas",
    "slug": "insurvas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "insurvas",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#08110f",
    "ios": {
      "bundleIdentifier": "com.insurvas.app",
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tel"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.insurvas.app",
      "adaptiveIcon": {
        "backgroundColor": "#0d4037",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08110f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Insurvas uses Face ID to unlock the app."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Insurvas uses Face ID to unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#07d6a0",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Insurvas uses the camera to scan documents a carrier asks for, snap receipts and take your profile photo.",
          "photosPermission": "Insurvas opens your photos so you can choose a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_serve_next": {
              "foregroundImage": "./assets/images/shortcuts/shortcut_serve_next.png",
              "backgroundColor": "#0d4037"
            },
            "shortcut_add_lead": {
              "foregroundImage": "./assets/images/shortcuts/shortcut_add_lead.png",
              "backgroundColor": "#0d4037"
            },
            "shortcut_check_number": {
              "foregroundImage": "./assets/images/shortcuts/shortcut_check_number.png",
              "backgroundColor": "#0d4037"
            },
            "shortcut_search": {
              "foregroundImage": "./assets/images/shortcuts/shortcut_search.png",
              "backgroundColor": "#0d4037"
            }
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "Today",
              "label": "Insurvas · Today",
              "description": "Your next callback and today’s calls",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/widgets/widget_today.png"
            },
            {
              "name": "AgencyMonth",
              "label": "Insurvas · Agency month",
              "description": "Submitted premium this month",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/widgets/widget_agency.png"
            }
          ]
        }
      ],
      "./plugins/with-android-app-actions",
      "./plugins/with-windows-short-cmake-dir"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ed4a9a31-3aab-47a6-90a8-cc10ce86a220"
      }
    },
    "owner": "rinorgllareva"
  }
}
