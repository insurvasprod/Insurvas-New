# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Dashboard > Project Settings > API > service_role secret key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Control plane (admin panel) ---
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Admin accounts always require an authenticator code after the password.
# Optional; only in production if the admin panel is on its own subdomain.
ADMIN_COOKIE_DOMAIN=

# --- Tenant plane ---
# Postgres connection as the `tenant_app` role (created by the SA-0.2 migration). Unlike the
# service-role key, RLS actually applies to this connection. Use the Supavisor pooler host if
# your network is IPv4-only — the direct db.*.supabase.co host is IPv6-only on some tiers.
TENANT_DB_URL=
# Must be a DIFFERENT secret from ADMIN_SESSION_SECRET, so the two session types can never be
# forged into one another.
TENANT_SESSION_SECRET=

# Origin used to build invite / password-reset / email-confirmation links.
# Falls back to the incoming request's origin when unset.
NEXT_PUBLIC_APP_URL=https://insurvas-new.vercel.app

# --- Transactional email (SA-4.11) ---
# External delivery is disabled by default. Set this to smtp only in an environment where real
# delivery is intentionally approved. Reserved QA domains (.test, .example, .invalid, localhost,
# and example.*) are always blocked.
EMAIL_DELIVERY_MODE=disabled
# Google SMTP. SMTP_PASSWORD must be a 16-character App Password, NOT the account password:
# turn on 2-Step Verification, then Google Account -> Security -> App passwords.
# SMTP_FROM_EMAIL must be the authenticated account or a verified "send as" alias — Gmail
# silently rewrites any other From address.
# Daily caps: ~500 recipients on free Gmail, 2,000 on Google Workspace.
# Port 587 is STARTTLS; 465 also works and switches to implicit TLS automatically.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Insurvas
SMTP_FROM_EMAIL=

# Verify with:  npm run email:test -- you@example.com

# --- One-time seeding (npm run seed:super-admin) ---
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_PASSWORD=

# --- Whop (SA-3.1) ---
# Sandbox: https://sandbox.whop.com/dashboard/developer
# Production keys and https://api.whop.com/api/v1 when going live.
WHOP_API_KEY=
WHOP_API_BASE_URL=https://sandbox-api.whop.com/api/v1
# Signing secret from the webhook row's Secret column. Shown once. Keep the ws_ prefix.
WHOP_WEBHOOK_SECRET=
# The Whop product that our plans attach to (Dashboard > Products).
WHOP_PRODUCT_ID=
# Optional: only needed when the key can act for more than one account.
WHOP_ACCOUNT_ID=

# --- Compliance vendor credentials (SA-4.8) ---
# 32+ random chars. Vendor credentials are encrypted before storage with this server-only key.
COMPLIANCE_VENDOR_ENCRYPTION_KEY=
# 32+ random chars. Encrypts the agency's federal tax ID (Settings › Agency profile). Falls back to
# COMPLIANCE_VENDOR_ENCRYPTION_KEY under its own label when unset; set it to keep the two apart.
AGENCY_TAX_ID_ENCRYPTION_KEY=
# Local/demo browser QA only; keep false or unset in deployed environments.
DEMO_SCREENING_MODE=false
NEXT_PUBLIC_DEMO_CALLBACKS=false
# Internal LA-1.23 scheduler and health endpoint. The scheduler must POST with this bearer secret;
# uptime monitoring can GET the same endpoint and alerts the address below if the heartbeat is stale.
UNCLAIMED_SLA_SECRET=
UNCLAIMED_SLA_ALERT_EMAIL=
UNCLAIMED_SLA_HEARTBEAT_SECONDS=900
CRON_SECRET=

# --- Period billing scheduler (backlog 24 / SA-6.1) ---
# CRON_SECRET above authorises /api/cron/period-billing as well; the scheduler sends it as a
# bearer token and the route fails closed without it, so an unset value means billing never runs.
#
# PERIOD_BILLING_SECRET is separate on purpose: it authorises the heartbeat and the manual run at
# /api/internal/period-billing, which are handed to monitoring and to whoever is on call, and
# should be revocable without touching the scheduler's own credential.
PERIOD_BILLING_SECRET=
# Where the "billing did not run" alert goes. Falls back to PLATFORM_ALERT_EMAIL, then
# SMTP_FROM_EMAIL; with none of the three set, the run is monitored and nobody is told.
PERIOD_BILLING_ALERT_EMAIL=
# How old the last successful run may be before the heartbeat reports unhealthy. Default 36 hours
# against a daily cron, so one missed run is tolerated and two are not. Clamped to 1h..7d.
PERIOD_BILLING_HEARTBEAT_SECONDS=129600

# --- Linked calendars (Settings › Calendar & availability, 20260924230200) ---
# The platform's OAuth applications. Until a provider's pair is set, its "Link" button is not
# offered and "Honour linked calendars" says linking is not set up. Register the redirect URI
# <APP_URL>/api/app/calendar-connections/callback on both.
# Google Cloud: OAuth client (web), Calendar API enabled, scope calendar.freebusy (+ openid email).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Microsoft Entra app registration: delegated Graph offline_access, User.Read, Calendars.ReadBasic.
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Optional; "common" accepts work, school and personal Microsoft accounts.
MICROSOFT_CALENDAR_TENANT=
# Encrypts the stored refresh tokens (AES-256-GCM). Any long random string; rotating it unlinks
# every calendar. /api/cron/calendar-busy (CRON_SECRET) refreshes busy time every 15 minutes.
CALENDAR_TOKEN_KEY=
